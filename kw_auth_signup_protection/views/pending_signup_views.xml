<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="kw_pending_signup_tree" model="ir.ui.view">
        <field name="name">kw.pending.signup.tree</field>
        <field name="model">kw.pending.signup</field>
        <field name="arch" type="xml">
            <tree>
                <field name="create_date"/>
                <field name="login"/>
                <field name="name"/>
                <field name="state"
                       decoration-success="state == 'verified'"
                       decoration-warning="state == 'pending'"
                       decoration-danger="state == 'expired'"
                       widget="badge"/>
                <field name="expiration"/>
                <field name="ip_address"/>
            </tree>
        </field>
    </record>

    <record id="kw_pending_signup_form" model="ir.ui.view">
        <field name="name">kw.pending.signup.form</field>
        <field name="model">kw.pending.signup</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="login"/>
                            <field name="name"/>
                            <field name="lang"/>
                        </group>
                        <group>
                            <field name="token"/>
                            <field name="expiration"/>
                            <field name="ip_address"/>
                            <field name="last_sent"/>
                        </group>
                    </group>
                    <group>
                        <field name="signup_values"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kw_pending_signup_search" model="ir.ui.view">
        <field name="name">kw.pending.signup.search</field>
        <field name="model">kw.pending.signup</field>
        <field name="arch" type="xml">
            <search>
                <field name="login"/>
                <field name="name"/>
                <field name="ip_address"/>
                <filter name="pending" string="Pending"
                        domain="[('state', '=', 'pending')]"/>
                <filter name="verified" string="Verified"
                        domain="[('state', '=', 'verified')]"/>
                <filter name="expired" string="Expired"
                        domain="[('state', '=', 'expired')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="State"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="kw_pending_signup_action" model="ir.actions.act_window">
        <field name="name">Pending Signups</field>
        <field name="res_model">kw.pending.signup</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="kw_pending_signup_search"/>
    </record>

    <menuitem id="kw_pending_signup_menu"
              parent="base.menu_custom"
              action="kw_pending_signup_action"
              sequence="90"/>

</odoo>
