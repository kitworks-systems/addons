<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="mail_template_signup_verification" model="mail.template">
        <field name="name">Signup: Email Verification</field>
        <field name="model_id" ref="model_kw_pending_signup"/>
        <field name="email_from">{{ (object.env.company.email or '') }}</field>
        <field name="email_to">{{ object.login }}</field>
        <field name="subject">Verify your email to complete registration</field>
        <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <table style="width: 600px; margin: 0 auto; border-collapse: collapse;">
        <tr>
            <td style="padding: 20px; font-family: Arial, sans-serif;">
                <p>Hello <t t-out="object.name">User</t>,</p>
                <p>Thank you for signing up. Please click the button below
                   to verify your email address and complete your registration:</p>
                <p style="text-align: center; margin: 30px 0;">
                    <a t-att-href="object._get_verification_url()"
                       style="background-color: #875A7B; color: #ffffff;
                              padding: 12px 24px; text-decoration: none;
                              border-radius: 4px; font-size: 16px;">
                        Verify Email
                    </a>
                </p>
                <p>Or copy and paste this link into your browser:</p>
                <p><a t-att-href="object._get_verification_url()"
                      t-out="object._get_verification_url()">Link</a></p>
                <p>This link will expire in
                    <t t-out="object.env['ir.config_parameter'].sudo().get_param(
                        'kw_auth_signup_protection.token_expiration_hours', '24')">24</t>
                    hours.</p>
                <p>If you did not request this registration, please ignore
                   this email.</p>
            </td>
        </tr>
    </table>
</div>
        </field>
    </record>

</odoo>
