<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_users_form_inherit_kw_hide_empty_groups" model="ir.ui.view">
        <field name="name">res.users.form.inherit.kw.hide.empty.groups</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']//field[@name='action_id']" position="after">
                <field name="kw_hide_empty_groups" widget="boolean_toggle" invisible="share"/>
            </xpath>
        </field>
    </record>

    <record id="view_users_form_simple_modif_inherit_kw_hide_empty_groups" model="ir.ui.view">
        <field name="name">res.users.form.simple.modif.inherit.kw.hide.empty.groups</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences_page']//field[@name='tz_offset']" position="after">
                <field name="kw_hide_empty_groups" widget="boolean_toggle" invisible="share"/>
            </xpath>
        </field>
    </record>

</odoo>
