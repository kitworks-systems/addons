<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="kw_html_image2attachment_task_line_cron" model="ir.cron" >
        <field name="name">Convert HTML image to attachment</field>
        <field name="active" eval="True"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="model_id" ref="model_kw_html_image2attachment_task_line"/>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="nextcall"
               eval="DateTime.now().strftime('%Y-%m-%d %H:%M:59')"/>
        <field name="state">code</field>
        <field name="code">model.search([('state','=','new')])[:10].action_process()</field>
    </record>
</odoo>
